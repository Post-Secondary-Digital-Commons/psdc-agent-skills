{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:skills:upstream-adoption-record:1",
  "title": "PSDC upstream adoption record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "componentId", "repository", "scope", "status", "decisionOwner", "governingRefs", "candidates", "selection", "upstreamProvides", "psdcOwns", "excluded", "evidence", "maintenance", "openGates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "componentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$" },
    "repository": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
    "scope": { "enum": ["common", "institution"] },
    "status": { "enum": ["proposed", "accepted", "deferred", "rejected"] },
    "decisionOwner": { "type": "string", "minLength": 3 },
    "decisionRef": { "type": "string", "minLength": 3 },
    "governingRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "rationale"],
      "properties": {
        "mode": { "enum": ["adopt", "adapter", "upstream-extension", "bounded-patch", "fork", "build"] },
        "project": { "type": "string", "minLength": 2 },
        "sourceRevision": { "type": "string", "minLength": 7 },
        "rationale": { "type": "string", "minLength": 10 }
      }
    },
    "upstreamProvides": { "$ref": "#/$defs/statements" },
    "psdcOwns": { "$ref": "#/$defs/statements" },
    "excluded": { "$ref": "#/$defs/statements" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "maintenance": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "updatePlan", "replacementTrigger"],
      "properties": {
        "owner": { "type": "string", "minLength": 2 },
        "updatePlan": { "type": "string", "minLength": 2 },
        "replacementTrigger": { "type": "string", "minLength": 2 },
        "patchBudget": { "type": "string", "minLength": 2 }
      }
    },
    "openGates": { "$ref": "#/$defs/statements" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
      "then": {
        "required": ["decisionRef"],
        "properties": {
          "candidates": { "minItems": 1 },
          "evidence": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "accepted" }, "selection": { "properties": { "mode": { "enum": ["adopt", "adapter", "upstream-extension", "bounded-patch", "fork"] } }, "required": ["mode"] } }, "required": ["status", "selection"] },
      "then": { "properties": { "selection": { "required": ["project", "sourceRevision"] } } }
    }
  ],
  "$defs": {
    "statements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "sourceUrl", "sourceRevision", "licenseEvidence", "fit", "limitations"],
      "properties": {
        "project": { "type": "string", "minLength": 2 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourceRevision": { "type": "string", "minLength": 7 },
        "licenseEvidence": { "type": "string", "minLength": 3 },
        "fit": { "type": "string", "minLength": 3 },
        "limitations": { "type": "string", "minLength": 3 }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "artifact", "revision", "result", "limitations"],
      "properties": {
        "method": { "type": "string", "minLength": 3 },
        "artifact": { "type": "string", "minLength": 3 },
        "revision": { "type": "string", "minLength": 3 },
        "result": { "enum": ["passed", "failed", "not-run", "documented-claim"] },
        "limitations": { "type": "string", "minLength": 3 }
      }
    }
  }
}
