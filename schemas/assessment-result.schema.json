{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.psdc.example/agent/assessment-result.schema.json",
  "title": "PSDC assessment result",
  "type": "object",
  "required": ["assessmentId", "observedAt", "snapshots", "dimensions", "findings", "limitations"],
  "properties": {
    "assessmentId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "assessor": { "type": "string" },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repository", "revision"],
        "properties": {
          "repository": { "type": "string" },
          "revision": { "type": "string" },
          "dirty": { "type": "boolean" },
          "includedPaths": { "type": "array", "items": { "type": "string" } },
          "excludedPaths": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "score", "evidence", "nextEvidence"],
        "properties": {
          "name": { "type": "string" },
          "score": { "type": "integer", "minimum": 0, "maximum": 4 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "counterEvidence": { "type": "array", "items": { "type": "string" } },
          "nextEvidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "basis", "statement", "evidence"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low", "note"] },
          "basis": { "enum": ["observed", "documented_claim", "inference", "assumption", "recommendation"] },
          "statement": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "remediation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

